{
  "schemaVersion": 1,
  "id": "tbfontfix",
  "version": "${version}",
  "name": "Traveler's Backpack Font Fix",
  "description": "Fixes a crash when Traveler's Backpack draws item decorations with a null font (e.g. with Building Wands).",
  "authors": ["pontyan"],
  "contact": {
    "sources": "https://github.com/p0ngch4ng/tbfontfix",
    "issues": "https://github.com/p0ngch4ng/tbfontfix/issues"
  },
  "license": "MIT",
  "environment": "client",
  "mixins": ["tbfontfix.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "1.18.x",
    "travelersbackpack": "*"
  }
}
